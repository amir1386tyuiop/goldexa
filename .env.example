# Development compose configuration.
# Copy this file to .env and replace every CHANGE_ME value with a locally generated value.
# Never commit .env or reuse these values outside local development.

COMPOSE_PROJECT_NAME=goldexa-dev

POSTGRES_DB=goldeksa
POSTGRES_USER=goldeksa_app
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_database_password
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6379

RABBITMQ_DEFAULT_USER=goldeksa_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME_generate_a_long_random_rabbitmq_password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
JWT_EXPIRES_IN=7d

BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=5174
AI_HOST_PORT=8000
FRONTEND_URL=http://localhost:5174
APP_BASE_URL=http://localhost:3001

GOLD_PRICE_SOURCE=tgju
AI_ENGINE_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Set to true only for the explicit development compose below.
ENABLE_DEVELOPMENT_SEED=true
