NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5174

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_use_a_local_only_database_password
DB_DATABASE=goldeksa

REDIS_HOST=localhost
REDIS_PORT=6379
# CACHE_DRIVER=redis uses Redis when reachable and falls back to in-memory.
# Set CACHE_DRIVER=memory to force the in-memory cache.
CACHE_DRIVER=redis

# Phase-2 modules are disabled by default. Enable explicitly when needed.
AI_ENGINE_ENABLED=false
AI_LOCAL_URL=http://localhost:8000
AI_LOCAL_TIMEOUT_MS=8000
AR_ENABLED=false

# Minutes a cart item reserves stock before the reservation expires.
CART_RESERVATION_MINUTES=15

JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
JWT_EXPIRES_IN=7d

RABBITMQ_URL=amqp://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5672

# Gold price feed. Set GOLD_PRICE_SOURCE=tgju to use tgju.org's public feed,
# otherwise a deterministic mock feed is used. GOLD_PRICE_API_URL overrides the
# default tgju endpoint; GOLD_PRICE_TGJU_DIVISOR converts ریال→تومان (e.g. 10).
GOLD_PRICE_SOURCE=tgju
GOLD_PRICE_API_URL=
GOLD_PRICE_API_KEY=
GOLD_PRICE_TGJU_DIVISOR=10

# Buy/sell spread applied to wallet gold trades (percent).
GOLD_TRADE_SPREAD_PERCENT=2

# Public base URL of this API (used for the ZarinPal callback).
APP_BASE_URL=http://localhost:3001

# ZarinPal payment gateway. Leave ZARINPAL_MERCHANT_ID empty to run in mock mode
# (full request→verify flow works locally with no real credentials).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_REFUND_ENDPOINT=

# OTP: in production keep RETURN_OTP_IN_RESPONSE=false so codes are never leaked.
RETURN_OTP_IN_RESPONSE=true

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CODE=cohere/north-mini-code
OPENROUTER_MODEL_ASSISTANT=nex-agi/nex-n2-pro:free
OPENROUTER_MODEL_ARCHITECTURE=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_MODEL_KYC_DOCUMENT=nvidia/llama-nemotron-rerank-vl-1b-v2:free
OPENROUTER_MODEL_SAFETY_CHECK=nvidia/nemotron-3.5-content-safety:free
OPENROUTER_MODEL_MARKETING_IMAGE=recraft/recraft-v4.1-pro
OPENROUTER_MODEL_VECTOR_ASSET=recraft/recraft-v4.1-vector
OPENROUTER_MODEL_PRODUCT_IMAGE=x-ai/grok-imagine-image-quality
OPENROUTER_MODEL_IMAGE_WORKFLOW=sourceful/riverflow-v2.5-pro
